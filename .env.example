# Plantilla de variables de entorno. Copia este archivo como ".env" y rellena
# los valores reales. El .env real NO se sube a git (está en .gitignore).
#
#   cp .env.example .env     (o copialo a mano)
#
# Clave de API de Anthropic, usada por la capa de traducción (tecla T).
# Obtenla en https://console.anthropic.com . Sin ella, la app sigue funcionando
# y la tecla T solo junta las glosas reconocidas.

ANTHROPIC_API_KEY=
