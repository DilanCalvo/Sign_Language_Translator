# Virtual environment
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# IDE
.vscode/
.idea/
*.code-workspace
.claude/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Exported conversation logs (per-session user data, not source)
logs/

# Internal context file (not part of the public project)
CLAUDE.md
ROADMAP.md
internal_project_documentation.txt

# Secrets — real API keys live in .env, which must NEVER be committed.
# .env.example is the committable template (no real key in it).
.env

# NOTE: trained models (model/*.h5, model/*.task), label maps (model/*.json)
# and the captured samples (data/real_capture/) ARE committed on purpose, so the
# app runs right after cloning. They are small (< 15 MB total).
#
# Stale model backups / evaluation plots are not source — keep them out of git.
model/*.bak
model/*.png
.playwright-cli/
